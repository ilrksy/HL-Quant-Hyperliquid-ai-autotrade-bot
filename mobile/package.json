{
  "name": "hl-quant-mobile",
  "version": "0.2.0",
  "description": "HL Quant Android app: a thin client for a self-hosted HL Quant server",
  "private": true,
  "type": "module",
  "scripts": {
    "copy:web": "node scripts/copy-web.mjs",
    "sync": "node scripts/copy-web.mjs && cap sync android",
    "apk": "node scripts/build-apk.mjs",
    "apk:debug": "node scripts/build-apk.mjs --debug",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
