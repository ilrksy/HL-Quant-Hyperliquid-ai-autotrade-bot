# --- mode -----------------------------------------------------------------
# paper (default) simulates fills locally with Hyperliquid fees. live sends real orders.
TRADING_MODE=paper
PAPER_START_EQUITY=10

# --- live trading (only read when TRADING_MODE=live) ----------------------
# Use an API / agent wallet key from https://app.hyperliquid.xyz/API — it can trade but cannot withdraw.
HL_PRIVATE_KEY=
# Main account address the agent wallet trades for (required when HL_PRIVATE_KEY is an agent key).
HL_ACCOUNT_ADDRESS=
# Must be set exactly to this value to enable live mode.
LIVE_CONFIRM=
# true = Hyperliquid testnet (free test USDC); strongly recommended before mainnet.
HL_TESTNET=false

# --- bot ------------------------------------------------------------------
BOT_COINS=BTC,ETH,SOL
BOT_INTERVAL=15m
BOT_LOOP_SEC=20

# --- server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# If set, POST endpoints require header x-api-token (set it in the browser: localStorage.apiToken = "...")
API_TOKEN=
