# HL Quant server configuration. Copy to .env and adjust.
# Most runtime options (risk, leverage, AI, Telegram) are edited in the dashboard and stored in DATA_DIR.

# --- mode -------------------------------------------------------------------
# paper (default) simulates fills locally with Hyperliquid fees; live sends real orders.
TRADING_MODE=paper
PAPER_START_EQUITY=10

# --- live trading (only read when TRADING_MODE=live) ------------------------
# Use an API wallet key from https://app.hyperliquid.xyz/API (it can trade but cannot withdraw).
HL_PRIVATE_KEY=
# Main account address the API wallet trades for.
HL_ACCOUNT_ADDRESS=
# Must be exactly I_ACCEPT_LOSS_RISK to enable live mode.
LIVE_CONFIRM=
# true = Hyperliquid testnet. Strongly recommended before mainnet.
HL_TESTNET=false

# --- server -----------------------------------------------------------------
# 127.0.0.1 = this machine only. 0.0.0.0 = phones and PCs on your network can connect.
HOST=127.0.0.1
PORT=8787
# Leave empty to generate a token on first start (printed and saved in DATA_DIR/server.json).
API_TOKEN=
# Where the database, paper account and token live.
DATA_DIR=./data
# Optional: serve a dashboard build from another folder.
# WEB_DIST=./web/dist

# --- first-run defaults (afterwards edit them in Settings) ------------------
BOT_COINS=BTC,ETH,SOL
BOT_INTERVAL=15m
BOT_LOOP_SEC=15
